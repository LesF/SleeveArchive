    // Toast State
    private string? toastMessage = null;
    private string toastType = "success";

    // Add Album Modal State
    private bool showAddModal = false;
    private string mbSearchQuery = "";
    private bool isSearchingMb = false;
    private bool hasSearchedMb = false;
    private List<MusicBrainzReleaseItem> mbSearchResults = new();
    private string newTitle = "";
    private string newArtist = "";
    private string newStatus = "Owned";
    private int? newVinylCondition = 5;
    private int? newCoverCondition = 5;
    private string? newMusicBrainzId = null;
    private string? createError = null;
