    // ALBUM DETAIL & EDIT FLOW
    // =========================================================================
    private void OpenAlbumDetails(Album album)
    {
        selectedAlbum = album;
        isEditMode = false;
        showDeleteConfirm = false;
        showEditMbSearch = false;
        showDetailModal = true;
    }

    private void CloseDetailModal()
    {
        showDetailModal = false;
        isEditMode = false;
        showDeleteConfirm = false;
    }

    private void StartEditAlbum()
    {
        if (selectedAlbum == null) return;
        editTitle = selectedAlbum.Title;
        editArtist = selectedAlbum.Artist;
        editStatus = selectedAlbum.Status;
        editVinylCondition = selectedAlbum.VinylCondition ?? 5;
        editCoverCondition = selectedAlbum.CoverCondition ?? 5;
        editMusicBrainzId = selectedAlbum.MusicBrainzId;
        editMbSearchQuery = $"{selectedAlbum.Title} {selectedAlbum.Artist}".Trim();
        editMbSearchResults.Clear();
        showEditMbSearch = false;
        editError = null;
        isEditMode = true;
    }

    private void CancelEdit()
    {
        isEditMode = false;
        showEditMbSearch = false;
    }

    private void ToggleEditMbSearch()
    {
        showEditMbSearch = !showEditMbSearch;
        if (showEditMbSearch && editMbSearchResults.Count == 0 && !string.IsNullOrWhiteSpace(editMbSearchQuery))
        {
            _ = SearchMusicBrainzForEdit();
        }
    }

    private async Task HandleEditMbSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchMusicBrainzForEdit();
        }
    }

    private async Task SearchMusicBrainzForEdit()
    {
        if (string.IsNullOrWhiteSpace(editMbSearchQuery)) return;

        isSearchingMb = true;
        editMbSearchResults.Clear();
        StateHasChanged();

        try
        {
            editMbSearchResults = await MbService.SearchReleasesAsync(editMbSearchQuery, limit: 8);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MB search edit error: {ex.Message}");
        }
        finally
        {
            isSearchingMb = false;
            StateHasChanged();
        }
    }

    private void SelectMusicBrainzReleaseForEdit(MusicBrainzReleaseItem item)
    {
        editTitle = item.Title;
        editArtist = item.Artist;
        editMusicBrainzId = item.Id;
        showEditMbSearch = false;
    }

    private async Task SaveAlbumEditsAsync()
    {
        if (selectedAlbum == null) return;

        if (string.IsNullOrWhiteSpace(editTitle))
        {
            editError = "Please enter an album title.";
            return;
        }

        if (string.IsNullOrWhiteSpace(editArtist))
        {
            editError = "Please enter an artist name.";
            return;
        }

        isSaving = true;
        editError = null;

        try
        {
            selectedAlbum.Title = editTitle.Trim();
            selectedAlbum.Artist = editArtist.Trim();
            selectedAlbum.Status = editStatus;
            selectedAlbum.VinylCondition = editStatus == "Upgrade wanted" ? null : editVinylCondition;
            selectedAlbum.CoverCondition = editStatus == "Upgrade wanted" ? null : editCoverCondition;
            selectedAlbum.MusicBrainzId = editMusicBrainzId;

            await DbService.UpdateAlbumAsync(selectedAlbum);
            isEditMode = false;
            ShowToast("Album updated successfully!");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            editError = $"Error updating album: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task DeleteAlbumAsync()
    {
        if (selectedAlbum == null) return;

        isSaving = true;
        try
        {
            var title = selectedAlbum.Title;
            await DbService.DeleteAlbumAsync(selectedAlbum.Id);
            showDetailModal = false;
            ShowToast($"Deleted \"{title}\"");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            ShowToast($"Delete failed: {ex.Message}", "error");
        }
        finally
        {
            isSaving = false;
        }
    }

    private void ShowToast(string message, string type = "success")
    {
        toastMessage = message;
        toastType = type;
        StateHasChanged();

        _ = Task.Run(async () =>
        {
            await Task.Delay(3500);
            toastMessage = null;
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task OpenMusicBrainzExternal(string? mbid)
    {
        if (!string.IsNullOrEmpty(mbid))
        {
            try
            {
                await Microsoft.Maui.ApplicationModel.Launcher.Default.OpenAsync($"https://musicbrainz.org/release/{mbid.Trim()}");
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error launching browser: {ex.Message}");
            }
        }
    }

    private void ReloadApp()
    {
        errorMsg = null;
        isLoading = true;
        StateHasChanged();
        _ = Task.Run(async () =>
        {
            try
            {
                await DbService.InitializeAsync();
                await LoadDataAsync();
            }
            catch (Exception ex)
            {
                errorMsg = $"Failed to load database: {ex.Message}";
            }
            finally
            {
                isLoading = false;
                await InvokeAsync(StateHasChanged);
            }
        });
    }
