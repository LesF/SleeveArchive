    // Detail & Edit Modal State
    private bool showDetailModal = false;
    private bool isEditMode = false;
    private Album? selectedAlbum = null;
    private string editTitle = "";
    private string editArtist = "";
    private string editStatus = "Owned";
    private int? editVinylCondition = null;
    private int? editCoverCondition = null;
    private string? editMusicBrainzId = null;
    private string? editError = null;
    private bool showDeleteConfirm = false;

    // MusicBrainz Search within Edit
    private bool showEditMbSearch = false;
    private string editMbSearchQuery = "";
    private List<MusicBrainzReleaseItem> editMbSearchResults = new();

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await DbService.InitializeAsync();
            await LoadDataAsync();
            isLoading = false;
        }
        catch (Exception ex)
        {
            errorMsg = $"Failed to load database: {ex.Message}";
            isLoading = false;
        }
    }

    private async Task LoadDataAsync()
    {
        try
        {
            var result = await DbService.QueryAlbumsAsync(SearchQuery, StatusFilter, currentPage, PageSize);
            albums = result.Albums;
            totalCount = result.TotalCount;
        }
        catch (Exception ex)
        {
            errorMsg = $"Query error: {ex.Message}";
        }
    }

    private string GetAlbumGradient(string? title)
    {
        if (string.IsNullOrEmpty(title)) return "linear-gradient(135deg, #6366f1, #a855f7)";
        int hash = 0;
        for (int i = 0; i < title.Length; i++)
        {
            hash = title[i] + ((hash << 5) - hash);
        }
        int hue1 = Math.Abs(hash % 360);
        int hue2 = (hue1 + 40) % 360;
        return $"linear-gradient(135deg, hsl({hue1}, 75%, 60%), hsl({hue2}, 85%, 45%))";
    }

    private string GetInitial(string? text)
    {
        if (string.IsNullOrEmpty(text))
            return string.Empty;
        return text[0].ToString();
    }

    private void ClearSearch()
    {
        SearchQuery = "";
    }

    private async Task NextPage()
    {
        if (currentPage < totalPages)
        {
            currentPage++;
            await LoadDataAsync();
        }
    }

    private async Task PrevPage()
    {
        if (currentPage > 1)
        {
            currentPage--;
            await LoadDataAsync();
        }
    }

    // =========================================================================
    // ADD ALBUM FLOW
    // =========================================================================
    private void OpenAddModal()
    {
        mbSearchQuery = "";
        mbSearchResults.Clear();
        hasSearchedMb = false;
        newTitle = "";
        newArtist = "";
        newStatus = "Owned";
        newVinylCondition = 5;
        newCoverCondition = 5;
        newMusicBrainzId = null;
        createError = null;
        isSaving = false;
        showAddModal = true;
    }

    private void CloseAddModal()
    {
        showAddModal = false;
    }

    private async Task HandleMbSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SearchMusicBrainz();
        }
    }

    private async Task SearchMusicBrainz()
    {
        if (string.IsNullOrWhiteSpace(mbSearchQuery)) return;

        isSearchingMb = true;
        hasSearchedMb = true;
        mbSearchResults.Clear();
        StateHasChanged();

        try
        {
            mbSearchResults = await MbService.SearchReleasesAsync(mbSearchQuery, limit: 12);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"MB search error: {ex.Message}");
        }
        finally
        {
            isSearchingMb = false;
            StateHasChanged();
        }
    }

    private void SelectMusicBrainzRelease(MusicBrainzReleaseItem release)
    {
        newTitle = release.Title;
        newArtist = release.Artist;
        newMusicBrainzId = release.Id;
        createError = null;
    }

    private void ClearMusicBrainzSelection()
    {
        newMusicBrainzId = null;
    }

    private async Task SaveNewAlbumAsync()
    {
        if (string.IsNullOrWhiteSpace(newTitle))
        {
            createError = "Please enter an album title.";
            return;
        }

        if (string.IsNullOrWhiteSpace(newArtist))
        {
            createError = "Please enter an artist name.";
            return;
        }

        isSaving = true;
        createError = null;

        try
        {
            var album = new Album
            {
                Title = newTitle.Trim(),
                Artist = newArtist.Trim(),
                Status = newStatus,
                VinylCondition = newStatus == "Upgrade wanted" ? null : newVinylCondition,
                CoverCondition = newStatus == "Upgrade wanted" ? null : newCoverCondition,
                MusicBrainzId = newMusicBrainzId
            };

            await DbService.AddAlbumAsync(album);
            showAddModal = false;
            ShowToast($"\"{album.Title}\" added to collection!");
            await LoadDataAsync();
        }
        catch (Exception ex)
        {
            createError = $"Error saving album: {ex.Message}";
        }
        finally
        {
            isSaving = false;
        }
    }

